---
import ArrowIcon from '../components/ArrowIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import SiteBuilder from '../components/builder/SiteBuilder.astro';
import PracticalQuestions from '../components/PracticalQuestions.astro';
import { services, process } from '../data/site';
import { withBase } from '../data/urls';
import '../styles/interior.css';
const details = [
  { when: 'Когда бизнесу нужен первый сайт или новый формат присутствия.', scope: ['Цель, аудитория и структура страниц', 'Визуальное направление и дизайн', 'Разработка для компьютеров и телефонов', 'Проверка и подготовка к публикации'] },
  { when: 'Когда предложение изменилось, а существующий сайт перестал его отражать.', scope: ['Разбор текущих страниц и сценариев', 'Обновление структуры и подачи', 'Новый дизайн ключевых экранов', 'Адаптивная реализация изменений'] },
  { when: 'Когда сайт уже есть и нужно решить конкретную задачу.', scope: ['Новые разделы или страницы', 'Обновление отдельных блоков', 'Улучшение навигации и сценариев', 'Проверка изменённой функциональности'] },
];
const expertise = [
  { title: 'Аналитика и улучшения', description: 'Настраиваю аналитику и ключевые действия: переходы к контактам, отправку заявок и другие события под задачу бизнеса. По данным предлагаю улучшения структуры, содержания и интерфейса.' },
  { title: 'Базовая безопасность', description: 'Проверяю работу с данными в формах, настройки доступа и основные технические риски выбранной платформы. Согласуем необходимые меры защиты под функции сайта.' },
  { title: 'Персональные данные', description: 'Учитываю требования к персональным данным при проектировании сайта. Настраиваю механизмы согласия и размещение документов с учётом форм и подключённых сервисов.' },
];
const questions = [
  { question: 'Как определяется стоимость?', answer: 'Цены «от» — ориентир для базового объёма, указанного у каждой услуги. Точная сумма зависит от состава страниц, функций и материалов. Согласуем объём и стоимость после обсуждения задачи, до начала работы. Многостраничные сайты, каталог, система управления и интеграции оцениваются отдельно.' },
  { question: 'Что получу после запуска?', answer: 'Опубликованный сайт, файлы проекта и информацию о его размещении. Состав передаваемых материалов согласуем в начале работы, чтобы было понятно, что вы получите в итоге.' },
  { question: 'Если нет текстов и фотографий?', answer: 'Можно начать с рассказа о вашем бизнесе. Вместе определим, какие тексты и изображения нужны, что уже есть и кто подготовит недостающие материалы. Объём этой работы и возможные расходы согласуем заранее.' },
  { question: 'Как согласуем изменения?', answer: 'Сначала согласуем задачу и структуру, затем дизайн и рабочие страницы. На каждом этапе я собираю обратную связь, а изменения уточняем вместе. Порядок правок обсуждаем до начала проекта; дополнительные страницы и функции согласуем отдельно по объёму, срокам и стоимости.' },
];
---
<SiteLayout mainClass="interior-page" title="Услуги" description="Создание сайтов с нуля, редизайн и доработка сайтов для бизнеса.">
  <header class="page-intro interior-intro"><p class="eyebrow">02 / Услуги</p><h1>Сайт под<br /><span>вашу задачу.</span></h1><p class="lead">Структура, дизайн и разработка — от первого наброска до готовых страниц. Выбираем объём работы под то, что нужно вашему бизнесу.</p><a class="text-link" href="#builder">Попробовать конструктор сайта <span aria-hidden="true"><ArrowIcon /></span></a></header>
  <section class="interior-services" aria-label="Направления работы">
    {services.map((service, index) => <article id={service.id} class="interior-service"><div><p class="eyebrow">{String(index + 1).padStart(2, '0')} / Направление</p><h2>{service.title}</h2><p>{details[index].when}</p><ServiceVisual index={index} /></div><div><p class="interior-statement">{service.description}</p><ul class="interior-scope">{details[index].scope.map(item => <li>{item}</li>)}</ul>
      <div class="service-price">
        <p class="service-price-amount"><span>от</span> <strong>{service.startingPrice.toLocaleString('ru-RU')} ₽</strong></p>
        <p class="service-price-scope">{service.baseScope}</p>
        <p class="service-price-note">Точную стоимость согласуем после обсуждения задачи, до начала работы.</p>
      </div>
      <a class="text-link" href={withBase(`/contact/?service=${service.id}`)}>{service.discussion} <span aria-hidden="true"><ArrowIcon /></span></a></div></article>)}
  </section>
  <section id="expertise" class="section service-expertise" aria-labelledby="expertise-heading">
    <header class="interior-split">
      <div><p class="eyebrow">Экспертиза / Для вашего сайта</p><h2 id="expertise-heading">Подготовлен<br />к работе.</h2></div>
      <p class="interior-statement">Продумываю, как измерять действия посетителей, работать с данными и развивать сайт после запуска.</p>
    </header>
    <ol class="expertise-rows">
      {expertise.map((item, index) => <li>
        <span class="expertise-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3><p>{item.description}</p>
      </li>)}
    </ol>
    <div class="expertise-notes">
      <p>Необходимые настройки и проверки определяем под задачу сайта и включаем в согласованный состав работы.</p>
      <p>Документы и схему обработки данных согласуем с владельцем бизнеса. Юридическую проверку документов профильным специалистом при необходимости обсуждаем отдельно.</p>
    </div>
  </section>
  <SiteBuilder />
  <section class="section interior-split"><div><p class="eyebrow">Процесс</p><h2>Понятно<br />на каждом шаге.</h2></div><ol class="interior-process">{process.map(step => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></section>
  <PracticalQuestions items={questions} />
  <section class="section interior-cta"><div><h2>Начнём с вашей задачи.</h2><p>Объём, сроки и стоимость обсуждаем после знакомства с проектом.</p></div><a class="button" href={withBase('/contact/')}>Обсудить проект <span aria-hidden="true"><ArrowIcon /></span></a></section>
</SiteLayout>
