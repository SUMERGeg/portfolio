---
import ArrowIcon from '../components/ArrowIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { contacts } from '../data/site';
import '../styles/interior.css';
---
<SiteLayout mainClass="interior-page" title="Контакты" description="Напишите Егору Данилову в Telegram или на email, чтобы обсудить сайт для вашего бизнеса.">
  <contact-context>
  <header class="page-intro interior-intro"><p class="eyebrow">05 / Контакты</p><h1>Обсудим<br /><span data-contact-title>ваш проект.</span></h1><p class="lead" data-contact-hint>Расскажите, какой сайт нужен, для кого он создаётся и что должен помочь сделать. Можно начать с нескольких предложений.</p></header>
  <section class="contact-message" aria-labelledby="contact-message-heading" hidden>
    <p class="eyebrow" id="contact-message-heading">Можно начать так</p>
    <p class="contact-message-text" data-contact-message></p>
    <div class="contact-message-actions"><button type="button" class="button button-secondary" data-copy-message>Скопировать сообщение</button><p class="contact-message-status" role="status" aria-live="polite" data-copy-status>Дополните текст своими деталями и отправьте в Telegram или по email.</p></div>
  </section>
  <ul class="interior-contacts">{contacts.map((contact, index) => <li><a href={contact.href} data-email-link={contact.href.startsWith('mailto:') ? '' : undefined}><span class="eyebrow">{index === 0 ? 'Telegram' : 'Email'}</span><span class="interior-contact-address">{contact.label.replace('Telegram · ', '')}<span aria-hidden="true"><ArrowIcon direction="diagonal" /></span></span></a></li>)}</ul>
  <section class="section interior-split"><div><p class="eyebrow">Для начала</p><h2>Что можно<br />написать.</h2></div><ol class="interior-process"><li><h3>О бизнесе и задаче</h3><p>Что предлагаете и зачем нужен сайт.</p></li><li><h3>О текущем сайте</h3><p>Если он есть, пришлите ссылку и расскажите, что хотите изменить.</p></li><li><h3>О пожеланиях</h3><p>Примеры, нужные разделы, желаемые сроки и ориентир по бюджету.</p></li></ol></section>
  </contact-context>
</SiteLayout>

<script>
  import { services } from '../data/site';
  import { builderBlocks, validBuilderBlocks, parseBuilderLayouts, getBuilderLayout } from '../data/builder';
  class ContactContext extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const params = new URLSearchParams(location.search);
      const selected = services.find(service => service.id === params.get('service'));
      if (!selected) return;
      const outline = validBuilderBlocks((params.get('blocks') || '').split(',').slice(0, 6));
      const layouts = parseBuilderLayouts(params.get('layouts') || '');
      const message = outline.length ? `${selected.message}\n\nНабросок структуры:\n${outline.map((id, index) => `${index + 1}. ${builderBlocks.find(block => block.id === id)!.title}${params.has('layouts') ? ` — ${getBuilderLayout(id, layouts[id]).title}` : ''}`).join('\n')}\n\nЭто предварительный набросок — хочу обсудить подходящую структуру.` : selected.message;
      this.querySelector('[data-contact-title]')!.textContent = outline.length ? 'сайт по вашему наброску.' : selected.contactTitle;
      this.querySelector('[data-contact-hint]')!.textContent = outline.length ? 'Выбранные разделы уже добавлены в сообщение. Дополните его парой слов о бизнесе — структуру и детали обсудим вместе.' : `${selected.contactHint} Готовое ТЗ не нужно — детали обсудим вместе.`;
      this.querySelector('[data-contact-message]')!.textContent = message;
      this.querySelector<HTMLElement>('.contact-message')!.hidden = false;
      const email = this.querySelector<HTMLAnchorElement>('[data-email-link]');
      if (email) email.href = `${email.getAttribute('href')!.split('?')[0]}?subject=${encodeURIComponent(selected.discussion)}&body=${encodeURIComponent(message)}`;
      const copy = this.querySelector<HTMLButtonElement>('[data-copy-message]');
      const status = this.querySelector<HTMLElement>('[data-copy-status]');
      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(message);
          if (status) status.textContent = 'Сообщение скопировано. Вставьте его в переписку и дополните своими деталями.';
        } catch {
          if (status) status.textContent = 'Не удалось скопировать автоматически. Выделите текст сообщения выше и скопируйте его вручную.';
        }
      }, { signal: this.controller.signal });
    }
    disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get('contact-context')) customElements.define('contact-context', ContactContext);
</script>
