---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroProject from '../components/home/HeroProject.astro';
import HomeDetails from '../components/home/HomeDetails.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, projectHref } from '../data/projects';
import { withBase } from '../data/urls';
import '../styles/home.css';

const projects = await getProjects();
const featured = projects[0];
---

<SiteLayout mainClass="home-page">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow hero-label">Сайты для малого и среднего бизнеса</p>
      <h1 id="hero-heading" class="hero-headline"><span class="hero-headline-line">Сайты для бизнеса,</span> <span class="hero-headline-line">которые <span class="hero-headline-accent">работают</span></span></h1>
      <p class="hero-description">Проектирую и разрабатываю сайты: от понятной структуры до готовых страниц, удобных на компьютере и телефоне.</p>
      <div class="actions hero-actions">
        {featured && <a class="button" href={projectHref(featured)}>Смотреть проект <span aria-hidden="true">→</span></a>}
        <a class="button button-secondary" href={withBase('/work/')}>Все работы <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <HeroProject />
  </section>
  <section class="home-section home-work" aria-labelledby="projects-heading">
    <div class="home-section-heading">
      <div><p class="eyebrow">01 / Проекты</p><h2 id="projects-heading">Избранные проекты</h2></div>
      <a class="home-work-link" href={withBase('/work/')}>Все проекты <span aria-hidden="true">→</span></a>
    </div>
    <ul class="home-project-grid">
      {projects.map((project) => <li><ProjectCard project={project} /></li>)}
    </ul>
    <p class="home-work-note">Во всех трёх проектах — дизайн и разработка.</p>
  </section>
  <HomeDetails />
</SiteLayout>
