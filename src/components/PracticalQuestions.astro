---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---
<section class="section interior-split practical-questions" aria-labelledby="practical-questions-heading">
  <header>
    <p class="eyebrow">Перед началом работы</p>
    <h2 id="practical-questions-heading">Несколько<br />важных вопросов.</h2>
  </header>
  <div class="practical-questions-list">
    {items.map((item, index) => <details name="practical-questions" open={index === 0}>
      <summary><h3>{item.question}</h3><span class="practical-question-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12M10 4v12" /></svg></span></summary>
      <div class="practical-question-answer"><p>{item.answer}</p></div>
    </details>)}
  </div>
</section>
<style>
  .practical-questions header h2 { max-inline-size: 18ch; }
  .practical-questions-list { min-inline-size: 0; border-block-end: 1px solid var(--color-line); }
  details { border-block-start: 1px solid var(--color-line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.5rem; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
  summary h3 { margin: 0; font-size: clamp(1rem, 1.4vw, 1.25rem); letter-spacing: -.025em; line-height: 1.4; }
  summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 5px; border-radius: 4px; }
  .practical-question-icon { flex: 0 0 2rem; display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border: 1px solid var(--color-line); border-radius: 50%; color: var(--color-muted); transition: color 180ms, border-color 180ms; }
  .practical-question-icon svg { inline-size: 16px; block-size: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; transition: transform 220ms ease; }
  details[open] .practical-question-icon { color: var(--color-accent); border-color: var(--color-accent); }
  details[open] .practical-question-icon svg { transform: rotate(45deg); }
  .practical-question-answer { padding-block-end: 1.5rem; padding-inline-end: 3.5rem; }
  .practical-question-answer p { margin: 0; max-inline-size: 58ch; color: var(--color-muted); line-height: 1.7; }
  details[open] .practical-question-answer { animation: answer-reveal 180ms ease-out; }
  @keyframes answer-reveal { from { opacity: .4; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
  @media (hover: hover) { summary:hover h3 { color: var(--color-focus); } }
  @media (max-width: 47.999rem) { summary { gap: 1rem; padding-block: 1.25rem; } .practical-question-answer { padding-inline-end: 0; padding-block-end: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .practical-question-icon, .practical-question-icon svg { transition: none; } details[open] .practical-question-answer { animation: none; } }
</style>
