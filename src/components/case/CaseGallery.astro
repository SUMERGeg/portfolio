---
import { Image } from 'astro:assets';
import type { CaseScreen } from '../../data/project-media';
import { projectAnnotations } from '../../data/project-annotations';
import AnnotatedScreen from './AnnotatedScreen.astro';
interface Props { screens: CaseScreen[]; projectTitle: string; projectSlug: string; }
const { screens, projectTitle, projectSlug } = Astro.props;
---
<section class="case-gallery" aria-labelledby="screens-heading">
  <div class="case-section-heading"><p class="eyebrow">02 / Экраны и адаптивность</p><h2 id="screens-heading">Дизайн в деталях</h2><p class="case-annotation-hint">Три решения, которые помогают посетителю. Нажмите на синие отметки на экранах — расскажу, зачем нужна каждая деталь.</p></div>
  {screens.map((screen, index) => (
    <section class="case-screen" aria-labelledby={`screen-${screen.id}`}>
      <header class="case-screen-heading">
        <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {projectTitle}</p>
        <div><h3 id={`screen-${screen.id}`}>{screen.title}</h3><p>{screen.description}</p></div>
      </header>
      <div class="case-screen-pair">
        <figure class="case-screen-desktop">
          <figcaption>Для компьютера</figcaption>
          <AnnotatedScreen screen={screen} projectTitle={projectTitle} annotations={projectAnnotations[projectSlug]?.[screen.id] ?? []} />
        </figure>
        <figure class="case-screen-mobile">
          <figcaption>Для телефона</figcaption>
          <a href={screen.mobile.src} target="_blank" rel="noopener noreferrer" aria-label={`${projectTitle}: ${screen.title}, полный экран для телефона (в новой вкладке)`}>
            <Image src={screen.mobile} alt={`${projectTitle}: ${screen.title}, версия для телефона`} widths={[280, 390]} sizes="(max-width: 767px) 280px, 23vw" format="webp" quality={85} loading="lazy" />
          </a>
        </figure>
      </div>
    </section>
  ))}
</section>
